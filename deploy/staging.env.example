SACCO_DEMO_LOGINS_ENABLED=false
SACCO_AUTH_RATE_LIMIT_MAX_FAILURES=6
SACCO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SACCO_SMS_PROVIDER=replace_with_sms_provider
SACCO_EMAIL_PROVIDER=replace_with_email_provider
SACCO_MOBILE_MONEY_PROVIDER=replace_with_mobile_money_provider_mtn_momo_or_airtel_money
SACCO_MTN_MOMO_SUBSCRIPTION_KEY=replace_with_mtn_subscription_key_if_using_mtn
SACCO_MTN_MOMO_API_USER_ID=replace_with_mtn_api_user_id_if_using_mtn
SACCO_MTN_MOMO_API_KEY=replace_with_mtn_api_key_if_using_mtn
SACCO_MTN_MOMO_TARGET_ENVIRONMENT=replace_with_mtn_target_environment_if_using_mtn
SACCO_AIRTEL_MONEY_CLIENT_ID=replace_with_airtel_client_id_if_using_airtel
SACCO_AIRTEL_MONEY_CLIENT_SECRET=replace_with_airtel_client_secret_if_using_airtel
SACCO_AIRTEL_MONEY_COUNTRY_CODE=replace_with_airtel_country_code_if_using_airtel
SACCO_BOOTSTRAP_PLATFORM_ADMIN_FULL_NAME=replace_with_platform_owner_name
SACCO_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=replace_with_platform_owner_email
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PHONE=replace_with_platform_owner_phone
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=replace_with_strong_bootstrap_password
SACCO_MOBILE_MONEY_CALLBACK_SECRET=replace_with_24_plus_character_callback_secret
SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=true
SACCO_MOBILE_MONEY_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=300
STAGING_UI_BASE_URL=https://staging.example.com
STAGING_API_BASE_URL=https://staging-api.example.com/api/v1
