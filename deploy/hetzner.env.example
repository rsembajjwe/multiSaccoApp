DOMAIN=globalntereka.com
ACME_EMAIL=admin@globalntereka.com
POSTGRES_DB=sacco_app_prod
POSTGRES_USER=sacco_prod
POSTGRES_PASSWORD=replace_with_a_unique_24_plus_character_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
SACCO_DEMO_LOGINS_ENABLED=false
SACCO_FLEET_APPROVAL_SLA_ZONE=Africa/Kampala
SACCO_FLEET_APPROVAL_BUSINESS_DAY_START=08:00
SACCO_FLEET_APPROVAL_BUSINESS_DAY_END=17:00
SACCO_FLEET_APPROVAL_SLA_HOURS=8
SACCO_FLEET_APPROVAL_WARNING_REMAINING_HOURS=4
# Comma-separated ISO dates; update annually with observed Ugandan public holidays.
SACCO_FLEET_APPROVAL_HOLIDAYS=

# Two ways to start with a clean, admin-only system (no seeded demo SACCOs/staff/members/loans):
#  1. Recommended for go-live: keep SACCO_DEMO_LOGINS_ENABLED=false above. Production mode purges the
#     demo SACCOs and their data, suspends the seeded demo accounts, and enforces real secrets. The
#     bootstrap admin below becomes your only login.
#  2. Quick start without full production hardening: set SACCO_DEMO_LOGINS_ENABLED=true and uncomment
#     the line below. This removes the same demo seed and creates the bootstrap admin, but leaves the
#     strong-secret / provider / PII-encryption checks OFF - fine for initial setup, NOT for handling
#     real member money. Safe to leave enabled: it only touches known seed rows, never data you add.
#
# One-time live reset to exactly A-Z Community Group and Mutwe Community Group:
#   Set SACCO_TWO_SACCO_RESEED_ENABLED=true for one deployment only. The backend atomically purges every
#   other SACCO and its related rows, refreshes the retained groups, and emails new temporary passwords to
#   their chairperson, secretary, and treasurer. Set it back to false after the reseed reports complete.
SACCO_TWO_SACCO_RESEED_ENABLED=false
#     Switch to option 1 before going live.
# SACCO_RESET_TO_PLATFORM_ADMIN=true
SACCO_AUTH_RATE_LIMIT_MAX_FAILURES=6
SACCO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SACCO_PII_ENCRYPTION_KEY=replace_with_unique_32_plus_character_pii_key
SACCO_DOCUMENT_STORAGE_PROVIDER=local_filesystem
SACCO_DOCUMENT_STORAGE_LOCAL_ROOT=/var/lib/sacco/documents
SACCO_SMS_PROVIDER=afrosms
SACCO_AFROSMS_EMAIL=replace_with_afrosms_login_email
SACCO_AFROSMS_PASSWORD=replace_with_afrosms_password
SACCO_AFROSMS_SOURCE=replace_with_approved_afrosms_sender_name
SACCO_EMAIL_PROVIDER=gmail_smtp
SACCO_GMAIL_SMTP_USERNAME=replace_with_google_workspace_smtp_username
SACCO_GMAIL_SMTP_PASSWORD=replace_with_google_workspace_app_password
SACCO_GMAIL_SMTP_SSL_TRUST=*
SACCO_GMAIL_FROM_ADDRESS=replace_with_tereka_sender_email
SACCO_GMAIL_FROM_NAME=Tereka Online
SACCO_MOBILE_MONEY_PROVIDER=replace_with_mobile_money_provider
SACCO_BOOTSTRAP_PLATFORM_ADMIN_FULL_NAME=replace_with_platform_owner_name
SACCO_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=replace_with_platform_owner_email
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PHONE=replace_with_platform_owner_phone
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=replace_with_strong_bootstrap_password
SACCO_MOBILE_MONEY_CALLBACK_SECRET=replace_with_24_plus_character_callback_secret
SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=true
SACCO_MOBILE_MONEY_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=300
ALERTMANAGER_WEBHOOK_URL_FILE=replace_with_alertmanager_webhook_secret_file
GRAFANA_ADMIN_PASSWORD_FILE=replace_with_grafana_admin_password_secret_file
STAGING_UI_BASE_URL=https://globalntereka.com
STAGING_API_BASE_URL=https://globalntereka.com/api/v1
SACCO_STAFF_APP_ANDROID_MINIMUM_VERSION_CODE=25
SACCO_STAFF_APP_ANDROID_LATEST_VERSION_CODE=27
SACCO_STAFF_APP_ANDROID_UPDATE_URL=
SACCO_STAFF_APP_ANDROID_UPDATE_MESSAGE=A newer approved Staff app is available.
