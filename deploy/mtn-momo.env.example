# MTN MoMo (Collections) mobile-money configuration for the backend.
# Copy the values into your running environment (docker-compose backend.env, or export before
# starting the Java app), then RESTART the backend. Credentials are environment-backed; there is no
# runtime UI to enter them.
#
# NOTE: only one mobile-money provider is active at a time. Setting this to mtn_momo makes MTN the
# active provider for the whole platform (all SACCOs), gated per-SACCO by the collection mode.

SACCO_MOBILE_MONEY_PROVIDER=mtn_momo

# --- Sandbox (free, simulates payments; does NOT ring a real phone) ---
SACCO_MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
SACCO_MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# From the MTN MoMo developer portal (https://momodeveloper.mtn.com):
#  - SUBSCRIPTION_KEY: the "Primary key" of your Collections subscription.
#  - API_USER_ID / API_KEY: created via the sandbox provisioning calls (see the runbook).
SACCO_MTN_MOMO_SUBSCRIPTION_KEY=replace_with_collections_primary_key
SACCO_MTN_MOMO_API_USER_ID=replace_with_generated_api_user_uuid
SACCO_MTN_MOMO_API_KEY=replace_with_generated_api_key

# Callback verification. In sandbox there is no inbound provider callback, so you complete a payment
# by POSTing the callback yourself; keep signing OFF for that. In PRODUCTION set these to a strong
# secret and true, and give MTN your callback URL.
SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=false
SACCO_MOBILE_MONEY_CALLBACK_SECRET=

# --- Production (real prompt to the payer's phone; requires MTN merchant onboarding) ---
# SACCO_MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# SACCO_MTN_MOMO_TARGET_ENVIRONMENT=mtnuganda
# SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=true
# SACCO_MOBILE_MONEY_CALLBACK_SECRET=replace_with_a_strong_shared_secret
