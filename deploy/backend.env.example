POSTGRES_DB=sacco_app
POSTGRES_USER=sacco
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
SACCO_DEMO_LOGINS_ENABLED=false
SACCO_AUTH_RATE_LIMIT_MAX_FAILURES=6
SACCO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SACCO_SMS_PROVIDER=afrosms
SACCO_AFROSMS_EMAIL=replace_with_afrosms_login_email
SACCO_AFROSMS_PASSWORD=replace_with_afrosms_password
SACCO_AFROSMS_SOURCE=replace_with_approved_afrosms_sender_name
SACCO_EMAIL_PROVIDER=gmail_smtp
SACCO_GMAIL_SMTP_USERNAME=replace_with_google_workspace_smtp_username
SACCO_GMAIL_SMTP_PASSWORD=replace_with_google_workspace_app_password
SACCO_GMAIL_FROM_ADDRESS=replace_with_tereka_sender_email
SACCO_GMAIL_FROM_NAME=Tereka Online
SACCO_MOBILE_MONEY_PROVIDER=replace_with_mobile_money_provider
SACCO_BOOTSTRAP_PLATFORM_ADMIN_FULL_NAME=replace_with_platform_owner_name
SACCO_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=replace_with_platform_owner_email
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PHONE=replace_with_platform_owner_phone
SACCO_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=replace_with_strong_bootstrap_password
# Shared secret used to verify HMAC-SHA256 signed mobile-money callbacks. Required in production.
SACCO_MOBILE_MONEY_CALLBACK_SECRET=change_this_callback_secret
SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=true
SACCO_MOBILE_MONEY_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=300
