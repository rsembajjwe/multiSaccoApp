POSTGRES_DB=sacco_app
POSTGRES_USER=sacco
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
SACCO_DEMO_LOGINS_ENABLED=false
SACCO_AUTH_RATE_LIMIT_MAX_FAILURES=6
SACCO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SACCO_SMS_PROVIDER=demo_sms
SACCO_EMAIL_PROVIDER=demo_email
SACCO_MOBILE_MONEY_PROVIDER=demo_mobile_money
# Shared secret used to verify HMAC-SHA256 signed mobile-money callbacks. Required in production.
SACCO_MOBILE_MONEY_CALLBACK_SECRET=change_this_callback_secret
SACCO_MOBILE_MONEY_REQUIRE_SIGNED_CALLBACKS=true
SACCO_MOBILE_MONEY_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=300
