<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- DEV ONLY: permit cleartext HTTP to the local backend during development.
       10.0.2.2 = the Android emulator's route to the host machine's localhost.
       Production (https://globalntereka.com) is unaffected and stays TLS-only. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>
</network-security-config>
